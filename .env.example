# Production template for the PM2/bare-metal deployment.
# Copy to `.env` in the repository root, fill the secrets, build the frontend,
# then run: pm2 start ecosystem.config.cjs

# PostgreSQL
# All five POSTGRES_* values are required together in production.
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432
POSTGRES_DB=noki
POSTGRES_USER=noki
# Set this once. Noki builds the SQLAlchemy URL internally, including correct
# escaping, so DATABASE_URL and edits to config.py are not required.
POSTGRES_PASSWORD=
# For a remote PostgreSQL host, set an absolute CA bundle path. The backend
# builds a CERT_REQUIRED/check_hostname SSL context and rejects URL ssl modes.
DATABASE_SSL_CA_FILE=
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_POOL_TIMEOUT=30

# Redis / Celery
# Use a long URL-safe value; it must match the password embedded in REDIS_URL below.
REDIS_PASSWORD=
REDIS_URL=redis://:REPLACE_WITH_URL_SAFE_PASSWORD@127.0.0.1:6379/0
REDIS_MAX_CONNECTIONS=50

# Application
ENVIRONMENT=production
JWT_SECRET=
# Base64 for exactly 32 random bytes. Generate once, back it up separately, and never rotate casually.
DATA_ENCRYPTION_KEY=
ACCESS_TOKEN_MINUTES=15
REFRESH_TOKEN_DAYS=30
PASSWORD_CHANGE_RATE_LIMIT_ATTEMPTS=5
PASSWORD_CHANGE_RATE_LIMIT_WINDOW_SECONDS=3600
# Public API limits are applied per source IP and per valid API token.
PUBLIC_API_IP_RATE_LIMIT_REQUESTS=1200
PUBLIC_API_TOKEN_RATE_LIMIT_REQUESTS=600
PUBLIC_API_RATE_LIMIT_WINDOW_SECONDS=60
MAX_API_TOKENS_PER_USER=20
BACKEND_URL=https://noki.example.com
FRONTEND_URL=https://noki.example.com
CORS_ORIGINS=https://noki.example.com
# Public hostname plus loopback for PM2 health checks and the Next rewrite.
# No scheme, path, port, or wildcard.
TRUSTED_HOSTS=noki.example.com,127.0.0.1
COOKIE_SECURE=true
COOKIE_DOMAIN=
COOKIE_SAMESITE=lax
# Set false to pause new self-service accounts without affecting existing users.
PUBLIC_REGISTRATION_ENABLED=true
UPLOAD_DIR=/var/lib/noki/uploads
EXPECTED_DB_REVISION=0026_totp
# Transactional email (server-side only). Verify MAIL_FROM's domain in Resend
# and publish the SPF, DKIM and DMARC records shown in its dashboard.
RESEND_API_KEY=
MAIL_FROM=Noki <no-reply@noki.click>
MAIL_REPLY_TO=support@noki.click
MAIL_QUEUE=mail_queue
MAIL_RECIPIENT_RATE_LIMIT_ATTEMPTS=3
MAIL_RATE_LIMIT_WINDOW_SECONDS=3600
INVITATION_MAIL_ACTOR_RATE_LIMIT_ATTEMPTS=20
EXPORT_RATE_LIMIT_ATTEMPTS=3
EMAIL_VERIFICATION_TTL_HOURS=24
PASSWORD_RESET_TTL_MINUTES=30
INVITATION_TTL_DAYS=7
EXPORT_DIR=/var/lib/noki/exports

# Google OAuth 2.0 (leave both credentials empty to disable Google login).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=https://noki.example.com/api/v1/auth/google/callback

# Private S3/S3-compatible storage for normalized Google avatars. These four
# values are all-or-none; leaving all four empty disables avatar import while
# authentication continues to work with initials. They are never passed to frontend.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_STORAGE_BUCKET_NAME=
AWS_S3_ENDPOINT_URL=
# SigV4 signing region. Use the value required by the selected provider.
AWS_S3_REGION_NAME=us-east-1

# Keep this set to required outside a closed test environment. The explicit
# test override skips only ClamAV; all image and storage validation stays on.
AVATAR_MALWARE_SCAN_MODE=required
# clamd must be reachable through this local Unix socket before S3 avatar
# storage is enabled. Scanner errors fail closed and no object is uploaded.
CLAMAV_UNIX_SOCKET=/run/clamav/clamd.ctl

# Frontend. Keep the browser API same-origin; this value is frozen during `next build`.
NEXT_PUBLIC_API_URL=/api/v1
# Absolute public origin for metadata, sitemap and robots; frozen during next build.
NEXT_PUBLIC_SITE_URL=https://noki.click
BACKEND_INTERNAL_URL=http://127.0.0.1:8010
# Validation requires true — nginx must be terminating real HTTPS before you
# start PM2 with this file. Browsers ignore this header on plain HTTP
# responses, so it's harmless while nginx only listens on :80; just don't
# expose a broken/self-signed :443 while testing, or a browser that accepts
# it once will pin HSTS and lock itself out until the real cert is live.
ENABLE_HSTS=true

# Reverse-proxy trust: PM2 trusts only the loopback nginx proxy.
FORWARDED_ALLOW_IPS=127.0.0.1

# Process topology
BACKEND_PORT=8010
FRONTEND_PORT=3015
UVICORN_WORKERS=1
UVICORN_LIMIT_CONCURRENCY=200
CELERY_WORKER_CONCURRENCY=1
CELERY_MAIL_WORKER_CONCURRENCY=2
CELERY_BEAT_SCHEDULE=/var/lib/noki/celery/celerybeat-schedule
