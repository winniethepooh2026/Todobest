{
  "name": "noki-frontend",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "build:production": "next build",
    "start:production": "next start --hostname 127.0.0.1",
    "test": "tsc --project tsconfig.test.json && node --test .test-dist/components/editor/editor-utils.test.js .test-dist/lib/timezone.test.js .test-dist/lib/utils.test.js",
    "verify": "npm run typecheck && npm run lint && npm run build:production",
    "audit:production": "npm audit --omit=dev --audit-level=high",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write ."
  },
  "engines": {
    "node": ">=20.9.0 <25"
  },
  "dependencies": {
    "@dnd-kit/core": "6.3.1",
